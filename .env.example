# ─────────────────────────────────────────────────────────────────────────────
# Marketing Platform — environment contract
# Copy to `.env` (never commit it). Full reference: docs/ENVIRONMENT_VARIABLES.md
#   [required]  startup fails without it
#   [optional]  feature degrades gracefully / default applies
#   [planned]   reserved for a later milestone; not used yet. Provider groups must be
#               either completely filled in or completely empty.
# ─────────────────────────────────────────────────────────────────────────────

# ── APPLICATION ──────────────────────────────────────────────────────────────
NODE_ENV=development                 # [optional] development | test | production
WEB_URL=http://localhost:3000        # [optional] public URL of the web app (CORS + links in emails)
API_URL=http://localhost:4000        # [optional] internal URL of the API (web server proxies /api here)
API_PORT=4000                        # [optional] port the API listens on
LOG_LEVEL=info                       # [optional] fatal | error | warn | info | debug | trace | silent
CORS_ALLOWED_ORIGINS=                # [optional] extra comma-separated origins (WEB_URL is always allowed)
TRUST_PROXY=1                        # [optional] proxy hops in front of the API (1 = Next.js proxy / one LB)
COOKIE_DOMAIN=                       # [optional] e.g. .example.com when web and API use sibling subdomains

# ── DATABASE ─────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/marketing_platform   # [required] Atlas: mongodb+srv://user:pass@cluster/db
MONGODB_DB_NAME=                     # [optional] overrides the database in the URI
REDIS_URL=                           # [optional] redis:// or rediss:// — enables BullMQ queues + shared rate limits

# ── AUTHENTICATION ───────────────────────────────────────────────────────────
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=                   # [required] ≥ 32 chars
JWT_REFRESH_SECRET=                  # [required] ≥ 32 chars, different from the access secret
JWT_ACCESS_EXPIRES_IN=15m            # [optional] s | m | h | d
JWT_REFRESH_EXPIRES_IN=30d           # [optional] absolute session lifetime

# ── GOOGLE ADS ───────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=                    # [planned]
GOOGLE_CLIENT_SECRET=                # [planned]
GOOGLE_DEVELOPER_TOKEN=              # [planned]
GOOGLE_REDIRECT_URI=                 # [planned] e.g. http://localhost:4000/api/v1/integrations/google-ads/callback

# ── META ─────────────────────────────────────────────────────────────────────
META_APP_ID=                         # [planned]
META_APP_SECRET=                     # [planned]
META_REDIRECT_URI=                   # [planned]

# ── AI PROVIDERS ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=                      # [planned]
ANTHROPIC_API_KEY=                   # [planned]
GOOGLE_GEMINI_API_KEY=               # [planned]

# ── STORAGE ──────────────────────────────────────────────────────────────────
STORAGE_PROVIDER=local               # [planned] local | s3 (s3 requires all S3_* below)
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=

# ── EMAIL ────────────────────────────────────────────────────────────────────
# Without SMTP, invitation links are shown once to the inviter instead of emailed.
SMTP_HOST=                           # [optional] group: SMTP_HOST + SMTP_PORT + EMAIL_FROM
SMTP_PORT=
SMTP_USER=                           # [optional] group: SMTP_USER + SMTP_PASSWORD
SMTP_PASSWORD=
EMAIL_FROM=                          # e.g. "Marketing Platform <no-reply@example.com>"

# ── WEB (public) ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=Marketing Platform   # [optional] only NEXT_PUBLIC_* values reach the browser
