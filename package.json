{
  "name": "marketing-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant digital marketing, sales CRM and AI intelligence platform",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm run dev -w @mp/api\" \"npm run dev -w @mp/web\"",
    "dev:api": "npm run dev -w @mp/api",
    "dev:web": "npm run dev -w @mp/web",
    "dev:worker": "npm run dev:worker -w @mp/api",
    "build": "npm run build -w @mp/api && npm run build -w @mp/web",
    "start:api": "npm run start -w @mp/api",
    "start:web": "npm run start -w @mp/web",
    "start:worker": "npm run start:worker -w @mp/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "test": "npm run test --workspaces --if-present",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.2",
    "concurrently": "^10.0.6",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12"
  }
}
